# Copy to .env.local and fill in real values. Never commit .env.local.
#
# This is the STATIC ARCADE SITE (Vite). It has exactly one variable, and it is public —
# Vite inlines every VITE_* value into the built JavaScript, so nothing secret may ever
# live here. The backend's secrets belong in arcade-backend/.env.example instead.

# Origin of the token backend (arcade-backend), with no trailing slash.
# Example: https://arcade-api.cartercripe.com
#
# Leaving this blank is a supported state, not a broken one: src/lib/tokenApi.ts treats
# an empty base as "tokens unavailable", so the arcade runs exactly as it did before the
# token layer existed — no balance pill, no spend gate, every game still playable. That
# is the correct default for local game work.
#
# Whatever origin is set here must also be allowed by the backend's CORS list
# (arcade-backend/lib/cors.ts), since these calls send credentials.
VITE_TOKEN_API_BASE=
