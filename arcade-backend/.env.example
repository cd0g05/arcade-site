# Copy to .env.local and fill in real values. See README.md "One-time manual setup".
# Never commit .env.local — only this template is tracked.

# Database
# Neon PostgreSQL connection string from the Vercel Marketplace integration.
# Use the *-pooler endpoint (PgBouncer) — see tech-design.md "Spike result: Neon pooling".
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth.js session secret (REQUIRED — Auth.js v5 returns HTTP 500 on every /api/auth/*
# route without it). Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (primary identity provider)
# Create in Google Cloud Console: https://console.cloud.google.com
# Authorized redirect URI for local dev: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (optional, for account linking)
# Create in Discord Developer Portal: https://discord.com/developers/applications
# Authorized redirect URI for local dev: http://localhost:3001/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot API key (service-to-service auth for the Discord bot)
# Generate with: openssl rand -hex 32
BOT_API_KEY=

# Vercel Cron secret, guarding POST/GET /api/cron/settle-daily (lib/api-auth.ts
# requireCronAuth). Vercel sends it as `Authorization: Bearer $CRON_SECRET` on scheduled
# invocations. Generate with: openssl rand -hex 32
#
# Unset is NOT "no auth" — requireCronAuth falls through to the bot key, so with this
# blank the cron route still rejects Vercel's own call. Set it in the Vercel project or
# the daily top-score settle silently never runs.
CRON_SECRET=

# CORS allow-list for browser calls from the arcade site (lib/cors.ts). These routes are
# cookie-authenticated, so this is an explicit allow-list, never origin reflection.
#
# https://arcade.cartercripe.com is always allowed and does not need listing here; in
# non-production NODE_ENV, localhost:5173 and 127.0.0.1:5173 are added automatically.
# Use this only for additional exact origins, comma-separated.
CORS_ALLOWED_ORIGINS=

# Host suffixes admitting per-deployment preview URLs, which cannot be enumerated.
# Comma-separated, https only, matched on a dot boundary (e.g. `.vercel.app`).
# Leave blank unless previews of the arcade site need to reach this API.
CORS_ALLOWED_ORIGIN_SUFFIXES=
